# Project SUNNY — Environment Configuration
# Copy this to .env and fill in your actual secrets
# NEVER commit .env to git

# Tailscale Network
TAILSCALE_IP=100.1.1.2
TAILSCALE_PORT=5000

# Claude API (for LLM requests — email triage, task interpretation, etc.)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Sonic API (for fluent TTS voice)
SONIC_API_KEY=sk-sonic-...

# Twilio (for phone calls)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Discord (for activity logging and alerts)
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...
DISCORD_BOT_TOKEN=your_bot_token_here

# Notion (for final item storage)
NOTION_API_KEY=secret_...

# Obsidian Vault
OBSIDIAN_VAULT_PATH=sunny-vault

# Spending Limits (in cents, provider-level hard caps)
CLAUDE_MONTHLY_BUDGET_CENTS=2000
TWILIO_MONTHLY_BUDGET_CENTS=1000
